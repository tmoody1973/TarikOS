# Stagehand 3.7 depends on ai@^5; Plate's AI kit peer-requires ai@^7. npm
# resolves this correctly on its own — the root and @platejs/ai share ai@7
# while @browserbasehq/stagehand keeps a nested ai@5, so /browse is untouched
# (verified with `npm ls ai`). Strict peer resolution refuses to even try.
#
# This file exists so Vercel's install succeeds too: without it the build
# fails on ERESOLVE and the deploy never happens.
#
# Remove when Stagehand 4 lands here — it dropped the `ai` dependency
# entirely, so the conflict disappears with the upgrade.
legacy-peer-deps=true
